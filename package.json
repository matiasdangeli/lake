{
  "name": "lake",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LAKE — Ride the loop. Entrenamiento en bicicleta alrededor del Lago Municipal de Colón.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "npm run assets:branding && npm run assets:challenges",
    "assets:branding": "node scripts/generate-branding.mjs",
    "assets:challenges": "node scripts/generate-challenge-art.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "e2e": "node scripts/e2e.mjs",
    "smoke:subpath": "node scripts/smoke-subpath.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
